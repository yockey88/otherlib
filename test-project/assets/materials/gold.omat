# POC metallic material: metalness rides the gbuffer normal alpha into the shading pass —
# the lambert body fades out with metalness, specular tints by albedo, and the body becomes
# mirrored procedural sky + a 30% irradiance floor (see docs/material-poc-transparent-metallic.md).
# roughness carries the old specular_reflectivity value (the shading pass reads albedo.a as a
# scalar factor), so polished metal wants it high
asset-type = "material"
name = "gold"

[params]
base_color = [1.0, 0.766, 0.336, 1.0]
roughness = 0.85
metalness = 1.0
