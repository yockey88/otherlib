---
Language: Cpp
BasedOnStyle: Google
Cpp11BracedListStyle: false
IndentPPDirectives: BeforeHash

IndentWidth: 2
IndentRequires: true
ContinuationIndentWidth: 2
ColumnLimit: 0

DerivePointerAlignment: false
PointerAlignment: Left

NamespaceIndentation: All
CompactNamespaces: false
FixNamespaceComments: true

AlignConsecutiveBitFields: true
BitFieldColonSpacing: Both

AlignTrailingComments: true

AllowShortBlocksOnASingleLine: Empty
AllowShortCaseLabelsOnASingleLine: true
AllowShortLambdasOnASingleLine: Inline

AlwaysBreakTemplateDeclarations: Yes
BreakBeforeConceptDeclarations: true
BreakBeforeTernaryOperators: false

SpaceBeforeInheritanceColon: true
SpaceBeforeParens: ControlStatements
AlignOperands: DontAlign

AlignAfterOpenBracket: BlockIndent

ConstructorInitializerAllOnOneLineOrOnePerLine: false

BreakBeforeBraces: Custom
BraceWrapping:
  AfterEnum: false
  AfterStruct: false
  AfterClass: false
  SplitEmptyFunction: false
  AfterControlStatement: false
  AfterNamespace: false
  AfterFunction: false
  AfterUnion: false
  AfterExternBlock: false
  BeforeCatch: false
  BeforeElse: false
  SplitEmptyRecord: false
  SplitEmptyNamespace: false

IncludeCategories:
  - Regex:           '<([A-Za-z0-9\/-_])+>'
    Priority:        1
  - Regex:           '<((glm|spdlog|entt|glad|gtest|gmock|imgui(zmo)?|json|toml++|magic_enum|refl|nlohmann|assimp|SDL3|steam|asio|dotnet|mio|physx|Jolt)\/ | SDL*)>'
    Priority:        2
  - Regex:           '<([A-Za-z0-9\/-_])+\.h(pp|xx|h)?>'
    Priority:        3
  - Regex:           '"((core|event|command|math|serialization|thread|input)\/)'
    Priority:        4
  - Regex:           '"((renderer|model|gpu_resource|script|bindings|dotnet|python|lua|network|physics|physics_world)\/)'
    Priority:        5
  - Regex:           '"((object|scene)\/)'
    Priority:        6
  - Regex:           '"((terminal|rendering-pipelines|driver|project|plugin|scripting|ui|vm|tools)\/)'
    Priority:        7
  - Regex:           '"([A-Za-z0-9\/-_])+\.h(pp|xx|h)?"'
    Priority:        8
---
Language: CSharp
BreakBeforeBraces: Custom
BraceWrapping:
  AfterEnum: false
  AfterStruct: false
  AfterClass: false
  SplitEmptyFunction: false
  AfterControlStatement: false
  AfterNamespace: false
  AfterFunction: false
  AfterUnion: false
  AfterExternBlock: false
  BeforeCatch: false
  BeforeElse: false
  SplitEmptyRecord: false
  SplitEmptyNamespace: false
---
Language: Proto
DisableFormat: true
