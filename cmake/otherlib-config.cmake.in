## Include helper macros for creating Other drivers/applications
include("${CMAKE_CURRENT_LIST_DIR}/add_other_driver.cmake")

## Helper function to setup external libraries
function(_otherlib_setup_external_lib TARGET_NAME NAMESPACE LIB_TYPE HEADER_SUBDIR)
  set(LIB_NAMES ${ARGN})
  
  find_library(${TARGET_NAME}_LIBRARY 
    NAMES ${LIB_NAMES}
    PATHS "${OTHERLIB_LIB_DIR}"
    NO_DEFAULT_PATH
  )

  find_library(${TARGET_NAME}_LIBRARY_RELEASE
    NAMES ${LIB_NAMES}
    PATHS "${OTHERLIB_LIB_DIR}"
    PATH_SUFFIXES release
    NO_DEFAULT_PATH
  )

  find_library(${TARGET_NAME}_LIBRARY_DEBUG
    NAMES ${LIB_NAMES}
    PATHS "${OTHERLIB_LIB_DIR}"
    PATH_SUFFIXES debug
    NO_DEFAULT_PATH
  )

  if(${TARGET_NAME}_LIBRARY OR ${TARGET_NAME}_LIBRARY_RELEASE OR ${TARGET_NAME}_LIBRARY_DEBUG)
    set(FULL_TARGET "${NAMESPACE}::${TARGET_NAME}")
    
    if(NOT TARGET ${FULL_TARGET})
      add_library(${FULL_TARGET} ${LIB_TYPE} IMPORTED)
      
      if(LIB_TYPE STREQUAL "STATIC")
        set_target_properties(${FULL_TARGET} PROPERTIES
          INTERFACE_INCLUDE_DIRECTORIES "${OTHERLIB_INCLUDE_DIR}/extern/${HEADER_SUBDIR}"
        )

        if(${TARGET_NAME}_LIBRARY_RELEASE)
          set_property(TARGET ${FULL_TARGET} APPEND PROPERTY IMPORTED_CONFIGURATIONS RELEASE)
          set_property(TARGET ${FULL_TARGET} APPEND PROPERTY IMPORTED_CONFIGURATIONS PROFILE)
          set_target_properties(${FULL_TARGET} PROPERTIES
            IMPORTED_LOCATION_RELEASE "${${TARGET_NAME}_LIBRARY_RELEASE}"
            IMPORTED_LOCATION_PROFILE "${${TARGET_NAME}_LIBRARY_RELEASE}"
          )
        endif()

        if(${TARGET_NAME}_LIBRARY_DEBUG)
          set_property(TARGET ${FULL_TARGET} APPEND PROPERTY IMPORTED_CONFIGURATIONS DEBUG)
          set_property(TARGET ${FULL_TARGET} APPEND PROPERTY IMPORTED_CONFIGURATIONS PROFILED)
          set_target_properties(${FULL_TARGET} PROPERTIES
            IMPORTED_LOCATION_DEBUG "${${TARGET_NAME}_LIBRARY_DEBUG}"
            IMPORTED_LOCATION_PROFILED "${${TARGET_NAME}_LIBRARY_DEBUG}"
          )
        endif()

        if(${TARGET_NAME}_LIBRARY AND NOT ${TARGET_NAME}_LIBRARY_RELEASE AND NOT ${TARGET_NAME}_LIBRARY_DEBUG)
          set_target_properties(${FULL_TARGET} PROPERTIES
            IMPORTED_LOCATION "${${TARGET_NAME}_LIBRARY}"
          )
        endif()
      else()
        set_target_properties(${FULL_TARGET} PROPERTIES
          INTERFACE_INCLUDE_DIRECTORIES "${OTHERLIB_INCLUDE_DIR}/extern/${HEADER_SUBDIR}"
        )

        if(${TARGET_NAME}_LIBRARY_RELEASE)
          set_property(TARGET ${FULL_TARGET} APPEND PROPERTY IMPORTED_CONFIGURATIONS RELEASE)
          set_property(TARGET ${FULL_TARGET} APPEND PROPERTY IMPORTED_CONFIGURATIONS PROFILE)
          set_target_properties(${FULL_TARGET} PROPERTIES
            IMPORTED_IMPLIB_RELEASE "${${TARGET_NAME}_LIBRARY_RELEASE}"
            IMPORTED_IMPLIB_PROFILE "${${TARGET_NAME}_LIBRARY_RELEASE}"
          )
        endif()

        if(${TARGET_NAME}_LIBRARY_DEBUG)
          set_property(TARGET ${FULL_TARGET} APPEND PROPERTY IMPORTED_CONFIGURATIONS DEBUG)
          set_property(TARGET ${FULL_TARGET} APPEND PROPERTY IMPORTED_CONFIGURATIONS PROFILED)
          set_target_properties(${FULL_TARGET} PROPERTIES
            IMPORTED_IMPLIB_DEBUG "${${TARGET_NAME}_LIBRARY_DEBUG}"
            IMPORTED_IMPLIB_PROFILED "${${TARGET_NAME}_LIBRARY_DEBUG}"
          )
        endif()

        if(${TARGET_NAME}_LIBRARY AND NOT ${TARGET_NAME}_LIBRARY_RELEASE AND NOT ${TARGET_NAME}_LIBRARY_DEBUG)
          set_target_properties(${FULL_TARGET} PROPERTIES
            IMPORTED_IMPLIB "${${TARGET_NAME}_LIBRARY}"
          )
        endif()
      endif()
    endif()
    
    ## Store target for linking to otherlib
    set(_OTHERLIB_EXTERNAL_TARGETS ${_OTHERLIB_EXTERNAL_TARGETS} ${FULL_TARGET} PARENT_SCOPE)
  endif()
endfunction()

## Setup external library targets
_otherlib_setup_external_lib(SDL3 SDL3 SHARED sdl SDL3)
_otherlib_setup_external_lib(assimp assimp SHARED assimp assimp-vc143-mt assimp-vc143-mt)
_otherlib_setup_external_lib(glad glad STATIC glad glad)
_otherlib_setup_external_lib(Jolt jolt STATIC jolt Jolt)

## Create convenience aliases
if(TARGET SDL3::SDL3 AND NOT TARGET SDL3)
  add_library(SDL3 ALIAS SDL3::SDL3)
endif()

if(TARGET glad::glad AND NOT TARGET glad)
  add_library(glad ALIAS glad::glad)
endif()

if(TARGET nfd::nfd)
  if(NOT TARGET nfd_d)
    add_library(nfd_d ALIAS nfd::nfd)
  endif()
  if(NOT TARGET nfd)
    add_library(nfd ALIAS nfd::nfd)
  endif()
endif()

if (TARGET jolt::Jolt)
  if(NOT TARGET Jolt)
    add_library(Jolt ALIAS jolt::Jolt)
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/otherlib-targets.cmake")

## compatibility aliases so CMakeLists written against the in-tree target names
##  (target_link_libraries(... otherlib otherlib_main)) work unchanged against the SDK
if(TARGET otherlib::otherlib AND NOT TARGET otherlib)
  add_library(otherlib ALIAS otherlib::otherlib)
endif()
if(TARGET otherlib::otherlib_main AND NOT TARGET otherlib_main)
  add_library(otherlib_main ALIAS otherlib::otherlib_main)
endif()

if(TARGET otherlib::otherlib)
  ## NOTE: The following macros are automatically defined for all consumers:
  ## - OTHER_ENVIRONMENT_WINDOWS/UNIX: Platform detection
  ## - OTHER_ENVIRONMENT_DEBUG/RELEASE/PROFILE/PROFILED: Build configuration
  ## - OTHER_API, OTHER_CLASS, OTHER_ALIGN: API decoration macros (defined in core/defines.hpp)
  ## - Platform-specific compatibility macros (NOMINMAX, WIN32_LEAN_AND_MEAN, etc.)
  ## 
  ## IMPORTANT: Consumers should NEVER define their own main() function.
  ## Instead, implement: other::exit_code other_main(const command_line& cmd, const config_table& config, const other::subsystem_registry& registry);
  ## 
  ## If you need to opt-out of the automatic main() (e.g., for plugins or special cases),
  ## add to your target: target_compile_definitions(your_target PRIVATE OTHER_DISABLE_MAIN)
  ## and then define OTHER_DISABLE_MAIN before including other.hpp

  ## Determine platform-specific macros. OTHER_APPLICATION / OTHER_CLIENT are set
  ##  per-target by the add_static_driver / add_dynamic_driver macros, NOT forced on
  ##  every consumer (plugins and dynamic drivers must not see OTHER_APPLICATION)
  set(_OTHERLIB_COMPILE_DEFS "")

  ## Platform detection
  if(CMAKE_SYSTEM_NAME STREQUAL "Windows")
    list(APPEND _OTHERLIB_COMPILE_DEFS 
      "OTHER_ENVIRONMENT_WINDOWS"
      "HAS_SEH_EXCEPTIONS"
      "NOMINMAX"
      "WIN32_LEAN_AND_MEAN"
      "_WIN32_WINNT=0x0A00"
      "_USE_MATH_DEFINES"
      "_SILENCE_CXX17_CODECVT_HEADER_DEPRECATION_WARNING"
      "_SILENCE_ALL_CXX17_DEPRECATION_WARNINGS"
      "_CRT_SECURE_NO_WARNINGS"
    )
  elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    list(APPEND _OTHERLIB_COMPILE_DEFS "OTHER_ENVIRONMENT_UNIX")
  endif()
  
  ## Build configuration detection
  list(APPEND _OTHERLIB_COMPILE_DEFS "$<$<CONFIG:Debug>:OTHER_ENVIRONMENT_DEBUG>" "$<$<CONFIG:Release>:OTHER_ENVIRONMENT_RELEASE>" "$<$<CONFIG:Profile>:OTHER_ENVIRONMENT_RELEASE>" "$<$<CONFIG:ProfileD>:OTHER_ENVIRONMENT_DEBUG>")
  
  set_target_properties(otherlib::otherlib PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${OTHERLIB_INCLUDE_DIR};${OTHERLIB_EXTERN_INCLUDE_DIRS}"
    INTERFACE_COMPILE_DEFINITIONS "${_OTHERLIB_COMPILE_DEFS}"
    ## exported module libs reference some prebuilt third-party libs by bare name
    ##  (SDL3, glad, Jolt, lua-5.4.4, ...); every consumer needs the SDK lib dirs
    INTERFACE_LINK_DIRECTORIES "${OTHERLIB_LIB_DIR};${OTHERLIB_LIB_DIR}/$<IF:$<OR:$<CONFIG:Debug>,$<CONFIG:ProfileD>>,debug,release>"
    ## the engine headers require the conformant preprocessor (__VA_OPT__) and utf-8
    INTERFACE_COMPILE_OPTIONS "$<$<CXX_COMPILER_ID:MSVC>:/Zc:preprocessor;/utf-8;/bigobj>"
  )
  
  ## Link external libraries to otherlib interface
  set(_OTHERLIB_LINK_LIBS "")
  if(TARGET SDL3::SDL3)
    list(APPEND _OTHERLIB_LINK_LIBS SDL3::SDL3)
  endif()
  if(TARGET assimp::assimp)
    list(APPEND _OTHERLIB_LINK_LIBS assimp::assimp)
  endif()
  if(TARGET glad::glad)
    list(APPEND _OTHERLIB_LINK_LIBS glad::glad)
  endif()
  if(TARGET nfd::nfd)
    list(APPEND _OTHERLIB_LINK_LIBS nfd::nfd)
  endif()
  if(TARGET jolt::Jolt)
    list(APPEND _OTHERLIB_LINK_LIBS jolt::Jolt)
  endif()
  if(TARGET Threads::Threads)
    list(APPEND _OTHERLIB_LINK_LIBS Threads::Threads)
  endif()
  
  if(_OTHERLIB_LINK_LIBS)
    set_property(TARGET otherlib::otherlib APPEND PROPERTY
      INTERFACE_LINK_LIBRARIES ${_OTHERLIB_LINK_LIBS}
    )
  endif()
endif()

check_required_components(otherlib)

if(TARGET otherlib::otherlib)
  if(NOT TARGET other::otherlib)
    add_library(other::otherlib ALIAS otherlib::otherlib)
  endif()
endif()

set(OTHERLIB_LIBRARY_DIR "@PACKAGE_OTHER_INSTALL_LIBDIR@")
set(OTHERLIB_BINARY_DIR "@PACKAGE_OTHER_INSTALL_BINDIR@")