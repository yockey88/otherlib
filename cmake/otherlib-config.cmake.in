find_package(Threads REQUIRED)

## Include helper macros for creating Other drivers/applications
include("${CMAKE_CURRENT_LIST_DIR}/add_other_driver.cmake")

## Helper function to setup external libraries
function(_otherlib_setup_external_lib TARGET_NAME NAMESPACE LIB_TYPE HEADER_SUBDIR)
  set(LIB_NAMES ${ARGN})
  
  find_library(${TARGET_NAME}_LIBRARY 
    NAMES ${LIB_NAMES}
    PATHS "${OTHERLIB_LIB_DIR}"
    NO_DEFAULT_PATH
  )

  if(${TARGET_NAME}_LIBRARY)
    set(FULL_TARGET "${NAMESPACE}::${TARGET_NAME}")
    
    if(NOT TARGET ${FULL_TARGET})
      add_library(${FULL_TARGET} ${LIB_TYPE} IMPORTED)
      
      if(LIB_TYPE STREQUAL "STATIC")
        set_target_properties(${FULL_TARGET} PROPERTIES
          IMPORTED_LOCATION "${${TARGET_NAME}_LIBRARY}"
          INTERFACE_INCLUDE_DIRECTORIES "${OTHERLIB_INCLUDE_DIR}/extern/${HEADER_SUBDIR}"
        )
      else()
        set_target_properties(${FULL_TARGET} PROPERTIES
          IMPORTED_IMPLIB "${${TARGET_NAME}_LIBRARY}"
          INTERFACE_INCLUDE_DIRECTORIES "${OTHERLIB_INCLUDE_DIR}/extern/${HEADER_SUBDIR}"
        )
      endif()
    endif()
    
    ## Store target for linking to otherlib
    set(_OTHERLIB_EXTERNAL_TARGETS ${_OTHERLIB_EXTERNAL_TARGETS} ${FULL_TARGET} PARENT_SCOPE)
  endif()
endfunction()

## Setup external library targets
_otherlib_setup_external_lib(SDL3 SDL3 SHARED sdl SDL3)
_otherlib_setup_external_lib(assimp assimp SHARED assimp assimp-vc143-mtd assimp-vc143-mt)
_otherlib_setup_external_lib(glad glad STATIC glad glad)
_otherlib_setup_external_lib(nfd nfd STATIC nativefiledialog nfd_d nfd)
_otherlib_setup_external_lib(flatbuffers flatbuffers STATIC flatbuffers flatbuffers)
_otherlib_setup_external_lib(python312 python STATIC python312 python312 python3)

## Create convenience aliases
if(TARGET SDL3::SDL3 AND NOT TARGET SDL3)
  add_library(SDL3 ALIAS SDL3::SDL3)
endif()

if(TARGET glad::glad AND NOT TARGET glad)
  add_library(glad ALIAS glad::glad)
endif()

if(TARGET nfd::nfd)
  if(NOT TARGET nfd_d)
    add_library(nfd_d ALIAS nfd::nfd)
  endif()
  if(NOT TARGET nfd)
    add_library(nfd ALIAS nfd::nfd)
  endif()
endif()

if(TARGET flatbuffers::flatbuffers AND NOT TARGET flatbuffers)
  add_library(flatbuffers ALIAS flatbuffers::flatbuffers)
endif()

if(TARGET python::python312)
  if(NOT TARGET python312)
    add_library(python312 ALIAS python::python312)
  endif()
  if(NOT TARGET python3)
    add_library(python3 ALIAS python::python312)
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/otherlib-targets.cmake")

if(TARGET otherlib::otherlib)
  ## NOTE: The following macros are automatically defined for all consumers:
  ## - OTHER_APPLICATION: Enables the otherlib main() entry point in other.hpp
  ## - OTHER_ENVIRONMENT_WINDOWS/UNIX: Platform detection
  ## - OTHER_ENVIRONMENT_DEBUG/RELEASE/PROFILE/PROFILED: Build configuration
  ## - OTHER_API, OTHER_CLASS, OTHER_ALIGN: API decoration macros (defined in core/defines.hpp)
  ## - Platform-specific compatibility macros (NOMINMAX, WIN32_LEAN_AND_MEAN, etc.)
  ## 
  ## IMPORTANT: Consumers should NEVER define their own main() function.
  ## Instead, implement: other::exit_code other_main(const command_line& cmd, const config_table& config)
  ## 
  ## If you need to opt-out of the automatic main() (e.g., for plugins or special cases),
  ## add to your target: target_compile_definitions(your_target PRIVATE OTHER_DISABLE_MAIN)
  ## and then define OTHER_DISABLE_MAIN before including other.hpp

  ## Determine platform-specific macros
  set(_OTHERLIB_COMPILE_DEFS "OTHER_APPLICATION")
  
  ## Platform detection
  if(CMAKE_SYSTEM_NAME STREQUAL "Windows")
    list(APPEND _OTHERLIB_COMPILE_DEFS 
      "OTHER_ENVIRONMENT_WINDOWS"
      "HAS_SEH_EXCEPTIONS"
      "NOMINMAX"
      "WIN32_LEAN_AND_MEAN"
      "_WIN32_WINNT=0x0A00"
      "_USE_MATH_DEFINES"
      "_SILENCE_CXX17_CODECVT_HEADER_DEPRECATION_WARNING"
      "_SILENCE_ALL_CXX17_DEPRECATION_WARNINGS"
      "_CRT_SECURE_NO_WARNINGS"
    )
  elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    list(APPEND _OTHERLIB_COMPILE_DEFS "OTHER_ENVIRONMENT_UNIX")
  endif()
  
  ## Build configuration detection
  if(CMAKE_BUILD_TYPE STREQUAL "Debug")
    list(APPEND _OTHERLIB_COMPILE_DEFS "OTHER_ENVIRONMENT_DEBUG")
  elseif(CMAKE_BUILD_TYPE STREQUAL "ProfileD")
    list(APPEND _OTHERLIB_COMPILE_DEFS "OTHER_ENVIRONMENT_PROFILED")
  elseif(CMAKE_BUILD_TYPE STREQUAL "Profile")
    list(APPEND _OTHERLIB_COMPILE_DEFS "OTHER_ENVIRONMENT_PROFILE")
  else()
    list(APPEND _OTHERLIB_COMPILE_DEFS "OTHER_ENVIRONMENT_RELEASE")
  endif()
  
  set_target_properties(otherlib::otherlib PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${OTHERLIB_INCLUDE_DIR};${OTHERLIB_EXTERN_INCLUDE_DIRS}"
    INTERFACE_COMPILE_DEFINITIONS "${_OTHERLIB_COMPILE_DEFS}"
  )
  
  ## Link external libraries to otherlib interface
  set(_OTHERLIB_LINK_LIBS "")
  if(TARGET SDL3::SDL3)
    list(APPEND _OTHERLIB_LINK_LIBS SDL3::SDL3)
  endif()
  if(TARGET assimp::assimp)
    list(APPEND _OTHERLIB_LINK_LIBS assimp::assimp)
  endif()
  if(TARGET glad::glad)
    list(APPEND _OTHERLIB_LINK_LIBS glad::glad)
  endif()
  if(TARGET nfd::nfd)
    list(APPEND _OTHERLIB_LINK_LIBS nfd::nfd)
  endif()
  if(TARGET flatbuffers::flatbuffers)
    list(APPEND _OTHERLIB_LINK_LIBS flatbuffers::flatbuffers)
  endif()
  if(TARGET python::python312)
    list(APPEND _OTHERLIB_LINK_LIBS python::python312)
  endif()
  if(TARGET Threads::Threads)
    list(APPEND _OTHERLIB_LINK_LIBS Threads::Threads)
  endif()
  
  if(_OTHERLIB_LINK_LIBS)
    set_property(TARGET otherlib::otherlib APPEND PROPERTY
      INTERFACE_LINK_LIBRARIES ${_OTHERLIB_LINK_LIBS}
    )
  endif()
endif()

check_required_components(otherlib)

if(TARGET otherlib::otherlib)
  if(NOT TARGET other::otherlib)
    add_library(other::otherlib ALIAS otherlib::otherlib)
  endif()
endif()

set(OTHERLIB_LIBRARY_DIR "@PACKAGE_OTHER_INSTALL_LIBDIR@")
set(OTHERLIB_BINARY_DIR "@PACKAGE_OTHER_INSTALL_BINDIR@")

## Add bin directory to PATH for finding DLLs
if(CMAKE_SYSTEM_NAME STREQUAL "Windows")
  set(ENV{PATH} "${OTHERLIB_BINARY_DIR};$ENV{PATH}")
endif()

