/entry: main

$main:
  set r0, test_project_folder.path
  set r1, [test_project_folder.length]
  syscall project.load
end

#test_project_folder {
  ; the spacesim project lives beside the engine repo and builds against the installed SDK
  ; .length: int32 = 11
  ; .path: string = "../spacesim"
  .length: int32 = 8
  .path: string = "spacesim"
  ; .length: int32 = 12
  ; .path: string = "test-project"
}