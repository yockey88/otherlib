/entry: main

$main:
  syscall core.time_micros
  ; call print_res
  mov rf, r0
  set r1, 3
  set rflag, 1
  syscall core.log_u64

  syscall core.random
  ; call print_res
  mov rf, r0
  set r1, 3
  set rflag, 1
  syscall core.log_u64

  set r0, 16
  set r1, 0x0040 ; output address
  set r2, 100    ; capacity
  syscall core.error_name

  set r0, 0x0040
  mov rflag, r1 ; bytes written
  set r2, 3
  syscall core.log
end

