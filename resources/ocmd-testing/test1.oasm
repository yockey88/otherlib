/entry: foo

$entry:
  dump r1
  dump r2
  dump r3
  set r4, data.first_addr
  ret
end

$foo:
  set r1, 10
  set r2, 11
  set r3, data.first_addr
  call entry
  dump r4
  stopdev
end

#data {
