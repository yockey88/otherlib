layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// Declare the cubemap image layout for writing
layout(rgba16f, binding = 0) uniform writeonly image3D OE_env_cubemap;

void main() {
  // coord within the target face
  ivec3 texel_coord = ivec3(gl_GlobalInvocationID);
  ivec3 size = imageSize(OE_env_cubemap);
  if (texel_coord.x >= size.x || texel_coord.y >= size.y || texel_coord.z >= size.z) {
    return;
  }

  // Generate your color data here
  // image3D: ivec3(x, y, depth)
  vec4 final_color = vec4(vec3(float(texel_coord.z) / 512.0), 1.0);
  imageStore(OE_env_cubemap, texel_coord, final_color);
}